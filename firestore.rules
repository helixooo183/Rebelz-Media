rules_version = '2';

// Rebelz Media — Firestore güvenlik kuralları
//
// Model:
//   users/{uid}                          kullanıcı profili (sahibi yazar)
//   users/{uid}/consents/{id}            koşul onay kayıtları (kanıt)
//   users/{uid}/blocked/{blockedUid}     engellenen kullanıcılar
//   usernames/{usernameLower}            kullanıcı adı tekilliği (kilit)
//   rooms/{roomId}                       sohbet (type: dm | group | channel)
//   rooms/{roomId}/messages/{msgId}      mesajlar (metin/fotoğraf/ses)
//
// Kullanıcı adı araması (`displayNameLower`/`usernameLower` aralık sorgusu)
// için Firestore'da tek alan indeksleri (otomatik) yeterlidir.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    function isUsername(value) {
      return value is string
        && value.matches('^[a-z0-9_]{3,20}$');
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'displayName', 'displayNameLower', 'email', 'emailVerified',
             'photoUrl', 'createdAt', 'lastSeenAt',
             'username', 'usernameLower', 'bio', 'avatarEmoji', 'avatarColor',
             'termsVersion', 'termsAcceptedAt',
           ])
        && isNonEmptyString(request.resource.data.displayName, 80);

      // Sahibi profil alanlarını günceller; e-posta/uid gibi alanlar sabit.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'displayName', 'displayNameLower', 'photoUrl', 'lastSeenAt',
               'username', 'usernameLower', 'bio', 'avatarEmoji',
               'avatarColor', 'termsVersion', 'termsAcceptedAt',
               'emailVerified',
             ])
        && isNonEmptyString(request.resource.data.displayName, 80)
        && (!('usernameLower' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isUsername(request.resource.data.usernameLower));

      allow delete: if false;

      // ------------------------------------------------------- koşul onayı
      // Kayıtlar oluşturulabilir, sonradan değiştirilemez (kanıt niteliği).
      match /consents/{consentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.accepted == true
          && isNonEmptyString(request.resource.data.version, 32)
          && request.resource.data.keys().hasOnly([
               'uid', 'email', 'version', 'accepted', 'platform', 'acceptedAt',
             ]);
        allow update, delete: if false;
      }

      // --------------------------------------------------------- engelleme
      // Herkes okuyabilir: gönderen "karşı taraf beni engelledi mi?"
      // kontrolünü ancak böyle yapabilir (mesaj kuralı da bunu kullanır).
      match /blocked/{blockedUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId)
          && request.resource.data.blockedUid == blockedUid;
        allow delete: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------ usernames
    // Kullanıcı adı kilidi: sahibi oluşturur/siler, herkes tekil okur.
    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && isUsername(request.resource.data.usernameLower);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- rooms
    match /rooms/{roomId} {
      function room() {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in room().memberIds;
      }

      function isChannel() {
        return room().type == 'channel';
      }

      // Kanal sahibi mi? (kanal dışındaki sohbetlerde iki taraf da eşittir.)
      function canWriteContent() {
        return !isChannel() || room().ownerUid == request.auth.uid;
      }

      // Karşı taraf beni engellediyse mesaj gönderemem. Doğrudan sohbetler
      // iki üyelidir; iki üyenin `blocked` listesi kontrol edilir.
      function peerBlockedMe() {
        return room().memberIds.size() == 2
          && (exists(/databases/$(database)/documents/users/$(room().memberIds[0])
                     /blocked/$(request.auth.uid))
              || exists(/databases/$(database)/documents/users/$(room().memberIds[1])
                     /blocked/$(request.auth.uid)));
      }

      allow get: if isMember();

      // Sorgu güvenliği: sohbetler `memberIds array-contains uid`, kanallar
      // `type == 'channel'` filtresiyle çekilir; iki kural da kanıtlanabilir.
      allow list: if signedIn()
        && (request.auth.uid in resource.data.memberIds
            || resource.data.type == 'channel');

      // Yeni sohbet / grup / kanal.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'name', 'about', 'createdBy', 'ownerUid', 'memberIds',
             'subscriberCount', 'createdAt', 'lastMessage', 'lastMessageAt',
             'lastSenderId', 'type', 'photoUrl', 'hiddenFor', 'memberNames',
             'memberPhotos', 'typing', 'readAt',
           ])
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 200
        && request.resource.data.memberIds.size() ==
             request.resource.data.memberIds.toSet().size()
        && (!('type' in request.resource.data)
            || request.resource.data.type in ['dm', 'group', 'channel'])
        // Kanal açan kişi sahibi olur; DM/grup kanal olamaz.
        && (request.resource.data.type != 'channel'
            || request.resource.data.ownerUid == request.auth.uid)
        && (request.resource.data.type == 'channel'
            || !('ownerUid' in request.resource.data));

      // Son mesaj, üye listesi, gizleme, "yazıyor…" ve okundu bilgisi.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastMessage', 'lastMessageAt', 'lastSenderId', 'memberIds',
               'hiddenFor', 'name', 'about', 'photoUrl', 'memberNames',
               'memberPhotos', 'type', 'typing', 'readAt', 'subscriberCount',
             ])
        && (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['typing', 'readAt', 'hiddenFor', 'memberIds',
                        'memberNames', 'memberPhotos'])
            || canWriteContent())
        && (!('lastMessage' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isNonEmptyString(request.resource.data.lastMessage, 2000))
        && (!('subscriberCount' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isChannel())
        && (!('memberIds' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || request.resource.data.memberIds.size() <= 200);

      // Silme: DM'de iki taraf, grupta oluşturan, kanalda sahibi.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && (resource.data.type == 'dm'
            || (resource.data.type == 'group'
                && resource.data.createdBy == request.auth.uid)
            || (resource.data.type == 'channel'
                && resource.data.ownerUid == request.auth.uid));

      // ------------------------------------------------------------- mesajlar
      match /messages/{messageId} {
        allow read: if isMember();

        allow create: if isMember()
          && !peerBlockedMe()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
               'senderId', 'senderName', 'senderPhotoUrl', 'text', 'type',
               'mediaBase64', 'mediaMime', 'durationMs', 'reply', 'reactions',
               'readBy', 'deleted', 'editedAt', 'createdAt',
             ])
          && isNonEmptyString(request.resource.data.senderName, 80)
          && request.resource.data.type in ['text', 'image', 'audio', 'system']
          && (!('mediaBase64' in request.resource.data)
              || request.resource.data.mediaBase64.size() <= 900000)
          && (!('mediaMime' in request.resource.data)
              || request.resource.data.mediaMime.size() <= 80)
          && (!('durationMs' in request.resource.data)
              || (request.resource.data.durationMs is int
                  && request.resource.data.durationMs >= 0
                  && request.resource.data.durationMs <= 300000))
          // Metin mesajı boş olamaz; medya mesajlarında metin opsiyoneldir.
          && (request.resource.data.type != 'text'
              || isNonEmptyString(request.resource.data.text, 2000))
          && (!('text' in request.resource.data)
              || request.resource.data.text.size() <= 2000)
          // Kanala yalnızca sahibi yazar.
          && (!isChannel() || room().ownerUid == request.auth.uid);

        // Tepki, okundu, düzenleme ve "silindi" işaretleri.
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'readBy', 'text', 'editedAt', 'deleted',
                         'mediaBase64', 'mediaMime', 'durationMs'])
          && (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions', 'readBy'])
              || resource.data.senderId == request.auth.uid);

        // Sohbeti silme akışı için üyeler mesajları kaldırabilir.
        allow delete: if isMember();
      }
    }

    // Varsayılan: her şeyi kapat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
