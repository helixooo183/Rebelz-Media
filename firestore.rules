rules_version = '2';

// Rebelz Media — Firestore güvenlik kuralları
//
// Model:
//   users/{uid}                          kullanıcı profili (sahibi yazar)
//   users/{uid}/consents/{id}            koşul onay kayıtları (kanıt)
//   users/{uid}/blocked/{blockedUid}     engellenen kullanıcılar
//   usernames/{usernameLower}            kullanıcı adı tekilliği (kilit)
//   rooms/{roomId}                       sohbet (type: dm | group | channel)
//   rooms/{roomId}/messages/{msgId}      mesajlar (metin/fotoğraf/ses)
//
// Kullanıcı adı araması (`displayNameLower`/`usernameLower` aralık sorgusu)
// için Firestore'da tek alan indeksleri (otomatik) yeterlidir.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    // Yönetici: `admins/{uid}` dokümanı olan kullanıcı (şikayet inceleme).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isUsername(value) {
      return value is string
        && value.matches('^[a-z0-9_]{3,20}$');
    }

    // Avatar alanı: `https://…` ya da galeriden seçilen base64 data URI.
    // 400 000 karakter ≈ 390 KB üst sınır (tipik değer 10-25 KB).
    function isPhoto(value) {
      return value is string && value.size() <= 400000;
    }

    // Kullanıcı adı kotası: alan varsa int olmalı ve en fazla 1 artabilir.
    function kotaGecerli() {
      return (!('usernameChanges' in request.resource.data)
              || (request.resource.data.usernameChanges is int
                  && request.resource.data.usernameChanges >= 0))
        && (!('usernameChanges' in request.resource.data)
              || !('usernameChanges' in resource.data)
              || request.resource.data.usernameChanges
                   <= resource.data.usernameChanges + 1);
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'displayName', 'displayNameLower', 'email', 'emailVerified',
             'photoUrl', 'createdAt', 'lastSeenAt',
             'username', 'usernameLower', 'bio', 'avatarEmoji', 'avatarColor',
             'usernameChanges', 'usernameWindowStart',
             'termsVersion', 'termsAcceptedAt', 'photoSource',
           ])
        && isNonEmptyString(request.resource.data.displayName, 80)
        && (!('photoUrl' in request.resource.data)
              || isPhoto(request.resource.data.photoUrl))
        && (!('photoSource' in request.resource.data)
              || request.resource.data.photoSource in ['custom', 'none']);

      // Sahibi profil alanlarını günceller; e-posta/uid gibi alanlar sabit.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'displayName', 'displayNameLower', 'photoUrl', 'lastSeenAt',
               'username', 'usernameLower', 'bio', 'avatarEmoji',
               'avatarColor', 'usernameChanges', 'usernameWindowStart',
               'termsVersion', 'termsAcceptedAt', 'photoSource',
               'emailVerified',
             ])
        && isNonEmptyString(request.resource.data.displayName, 80)
        && kotaGecerli()
        && (!('photoUrl' in request.resource.data)
              || isPhoto(request.resource.data.photoUrl))
        // Kullanıcı seçimi işareti: Google fotoğrafı bunu ezmez.
        && (!('photoSource' in request.resource.data)
              || request.resource.data.photoSource in ['custom', 'none'])
        && (!('usernameLower' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isUsername(request.resource.data.usernameLower));

      allow delete: if false;

      // ------------------------------------------------------- koşul onayı
      // Kayıtlar oluşturulabilir, sonradan değiştirilemez (kanıt niteliği).
      match /consents/{consentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.accepted == true
          && isNonEmptyString(request.resource.data.version, 32)
          && request.resource.data.keys().hasOnly([
               'uid', 'email', 'version', 'accepted', 'platform', 'acceptedAt',
             ]);
        allow update, delete: if false;
      }

      // ------------------------------------------- benden sil (mesaj gizleme)
      // "Benden sil" yalnızca sahibinin gördüğü bir işarettir; mesaj diğer
      // üyeler için silinmez (bkz. ChatRepository.hideMessageForMe).
      match /hiddenMessages/{hiddenId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && isNonEmptyString(request.resource.data.roomId, 128)
          && isNonEmptyString(request.resource.data.messageId, 128)
          && request.resource.data.keys().hasOnly([
               'roomId', 'messageId', 'createdAt',
             ]);
        allow update: if false;
      }

      // --------------------------------------------------------- engelleme
      // Herkes okuyabilir: gönderen "karşı taraf beni engelledi mi?"
      // kontrolünü ancak böyle yapabilir (mesaj kuralı da bunu kullanır).
      match /blocked/{blockedUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId)
          && request.resource.data.blockedUid == blockedUid;
        allow delete: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------ usernames
    // Kullanıcı adı kilidi: sahibi oluşturur/siler, herkes tekil okur.
    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && isUsername(request.resource.data.usernameLower);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- rooms
    match /rooms/{roomId} {
      function room() {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in room().memberIds;
      }

      function isChannel() {
        return room().type == 'channel';
      }

      // Kanal sahibi mi? (kanal dışındaki sohbetlerde iki taraf da eşittir.)
      // Kanal/grup sahibi mi?
      function isRoomOwner() {
        return room().get('ownerUid', room().get('createdBy', '')) ==
               request.auth.uid;
      }

      function isRoomMod() {
        return room().get('roles', {}).get(request.auth.uid, '') == 'mod';
      }

      // Kanallarda yalnızca sahip/moderatör yazar; `onlyModsPost` izni
      // kapatılırsa tüm aboneler yazabilir.
      function onlyModsPost() {
        return room().get('permissions', {}).get('onlyModsPost', true);
      }

      function canWriteContent() {
        return !isChannel() || isRoomOwner() || isRoomMod() || !onlyModsPost();
      }

      // Karşı taraf beni engellediyse mesaj gönderemem. Doğrudan sohbetler
      // iki üyelidir; iki üyenin `blocked` listesi kontrol edilir.
      function peerBlockedMe() {
        return room().memberIds.size() == 2
          && (exists(/databases/$(database)/documents/users/$(room().memberIds[0])
                     /blocked/$(request.auth.uid))
              || exists(/databases/$(database)/documents/users/$(room().memberIds[1])
                     /blocked/$(request.auth.uid)));
      }

      allow get: if isMember();

      // Sorgu güvenliği: sohbetler `memberIds array-contains uid`, kanallar
      // `type == 'channel'` filtresiyle çekilir; iki kural da kanıtlanabilir.
      allow list: if signedIn()
        && (request.auth.uid in resource.data.memberIds
            || resource.data.type == 'channel');

      // Yeni sohbet / grup / kanal.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'name', 'about', 'createdBy', 'ownerUid', 'memberIds',
             'subscriberCount', 'createdAt', 'lastMessage', 'lastMessageAt',
             'lastSenderId', 'type', 'photoUrl', 'hiddenFor', 'memberNames',
             'memberPhotos', 'typing', 'readAt', 'roles', 'permissions',
             'isPrivate',
           ])
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 200
        && request.resource.data.memberIds.size() ==
             request.resource.data.memberIds.toSet().size()
        && (!('type' in request.resource.data)
            || request.resource.data.type in ['dm', 'group', 'channel'])
        // Kanal açan kişi sahibi olur; DM/grup kanal olamaz.
        && (request.resource.data.type != 'channel'
            || request.resource.data.ownerUid == request.auth.uid)
        && (request.resource.data.type == 'channel'
            || !('ownerUid' in request.resource.data));

      // Son mesaj, üye listesi, gizleme, "yazıyor…" ve okundu bilgisi.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastMessage', 'lastMessageAt', 'lastSenderId', 'memberIds',
               'hiddenFor', 'name', 'about', 'photoUrl', 'memberNames',
               'memberPhotos', 'type', 'typing', 'readAt', 'subscriberCount',
               'roles', 'permissions', 'ownerUid', 'isPrivate',
             ])
        && (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['typing', 'readAt', 'hiddenFor', 'memberIds',
                        'memberNames', 'memberPhotos'])
            || canWriteContent())
        && (!('lastMessage' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isNonEmptyString(request.resource.data.lastMessage, 2000))
        && (!('subscriberCount' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isChannel())
        && (!('memberIds' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || (request.resource.data.memberIds.size() <= 200
                && (request.resource.data.memberIds
                      .hasAll(resource.data.memberIds)
                    || !(request.auth.uid in request.resource.data.memberIds)
                    || isRoomOwner() || isRoomMod())))
        // Rol/izin/sahiplik değişiklikleri yalnızca yönetime açıktır ve
        // sahiplik yalnızca mevcut sahip tarafından devredilebilir.
        && (!('roles' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isRoomOwner() || isRoomMod())
        && (!('permissions' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isRoomOwner() || isRoomMod())
        && (!('ownerUid' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || (isRoomOwner()
                && request.resource.data.ownerUid
                     in request.resource.data.memberIds))
        // Özel/halka açık ayarını yalnızca sahip değiştirir.
        && (!('isPrivate' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isRoomOwner())
        // Kanal/grup fotoğrafı: boyut sınırı + yalnızca sahip/moderatör.
        && (!('photoUrl' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || (isPhoto(request.resource.data.photoUrl)
                && (isRoomOwner() || isRoomMod())));

      // Silme: DM'de iki taraf, grupta oluşturan, kanalda sahibi.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && (resource.data.type == 'dm'
            || (resource.data.type == 'group'
                && resource.data.createdBy == request.auth.uid)
            || ((resource.data.type == 'channel' || resource.data.type == 'group')
                && resource.data.get('ownerUid',
                     resource.data.get('createdBy', '')) == request.auth.uid));

      // ------------------------------------------------------------- mesajlar
      match /messages/{messageId} {
        allow read: if isMember();

        allow create: if isMember()
          && !peerBlockedMe()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
               'senderId', 'senderName', 'senderPhotoUrl', 'text', 'type',
               'mediaBase64', 'mediaMime', 'durationMs', 'reply', 'reactions',
               'readBy', 'deleted', 'editedAt', 'createdAt', 'deletedBy',
             ])
          && isNonEmptyString(request.resource.data.senderName, 80)
          && request.resource.data.type in ['text', 'image', 'audio', 'system']
          && (!('mediaBase64' in request.resource.data)
              || request.resource.data.mediaBase64.size() <= 900000)
          && (!('mediaMime' in request.resource.data)
              || request.resource.data.mediaMime.size() <= 80)
          && (!('durationMs' in request.resource.data)
              || (request.resource.data.durationMs is int
                  && request.resource.data.durationMs >= 0
                  && request.resource.data.durationMs <= 300000))
          // Metin mesajı boş olamaz; medya mesajlarında metin opsiyoneldir.
          && (request.resource.data.type != 'text'
              || isNonEmptyString(request.resource.data.text, 2000))
          && (!('text' in request.resource.data)
              || request.resource.data.text.size() <= 2000)
          // Kanala yalnızca sahibi/moderatörü yazar (izin açıksa herkes).
          && (!isChannel() || isRoomOwner() || isRoomMod() || !onlyModsPost());

        // Tepki, okundu, düzenleme, "silindi" işareti ve geri alma.
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'readBy', 'text', 'editedAt', 'deleted',
                         'mediaBase64', 'mediaMime', 'durationMs',
                         'deletedBy'])
          && (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions', 'readBy'])
              // Gönderen kendi mesajını düzenler/siler/geri alır.
              || resource.data.senderId == request.auth.uid
              // Yetkili moderatör/sahip yalnızca içerik alanlarını temizleyip
              // "silindi" işaretleyebilir (veya geri alabilir).
              || (room().get('permissions', {})
                      .get('modsDeleteMessages', false) == true
                  && (isRoomOwner() || isRoomMod())
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['text', 'mediaBase64', 'mediaMime',
                                 'durationMs', 'deleted', 'deletedBy',
                                 'editedAt'])));

        // Sohbeti silme akışı için üyeler mesajları kaldırabilir.
        // Kanal/gruplarda moderatörler yalnızca izin verildiyse silebilir.
        allow delete: if signedIn()
          && (resource.data.senderId == request.auth.uid
              || (room().get('permissions', {})
                      .get('modsDeleteMessages', false) == true
                  && (isRoomOwner() || isRoomMod()))
              || (isRoomOwner() && !isChannel()));
      }
    }

    // ----------------------------------------------------------------- admins
    // Yönetici listesi yalnızca konsoldan/CLI'dan yazılır; istemci yalnızca
    // kendi kaydının olup olmadığını okuyabilir.
    match /admins/{adminUid} {
      allow get: if signedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    // ----------------------------------------------------------- room_invites
    // Davet bağlantıları: oluşturan yazar/iptal eder, giriş yapan herkes
    // kodu okuyabilir (katılmak için gereken tek bilgi kodun kendisidir).
    match /room_invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isNonEmptyString(request.resource.data.roomId, 128)
        && request.resource.data.keys().hasOnly([
             'roomId', 'createdBy', 'roomName', 'roomType', 'createdAt',
           ]);
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(resource.data.roomId))
                 .data.get('ownerUid', '') == request.auth.uid);
    }

    // ---------------------------------------------------------------- reports
    // Şikayetler yalnızca eklenir; gönderen kendi kaydını, yönetici tümünü
    // okuyabilir (inceleme paneli).
    match /reports/{reportId} {
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && isNonEmptyString(request.resource.data.reason, 60)
        && request.resource.data.details.size() <= 1000
        && request.resource.data.messageSnippet.size() <= 200
        && request.resource.data.keys().hasOnly([
             'reporterUid', 'reporterName', 'targetUid', 'targetName',
             'reason', 'details', 'roomId', 'messageId', 'messageSnippet',
             'status', 'createdAt',
           ]);
      allow read: if signedIn()
        && (resource.data.reporterUid == request.auth.uid || isAdmin());

      // Yönetici yalnızca durumu ('open'|'resolved'|'dismissed') değiştirir.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status
             in ['open', 'resolved', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if false;
    }

    // -------------------------------------------------------- support_requests
    // Destek talepleri de yalnızca eklenir; sahibi kendi taleplerini okur.
    match /support_requests/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && isNonEmptyString(request.resource.data.topic, 40)
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'email', 'topic', 'message', 'status',
             'platform', 'createdAt',
           ]);
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Varsayılan: her şeyi kapat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
