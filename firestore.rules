rules_version = '2';

// Sohbet — Firestore güvenlik kuralları
//
// Model:
//   users/{uid}                        kullanıcı profili (sahibi yazar)
//   rooms/{roomId}                     sohbet odası
//   rooms/{roomId}/messages/{msgId}    mesajlar (yalnızca oluşturma)
//
// Not: Bu iskelet "her giriş yapan tüm odaları görür" varsayımıyla çalışır
// (grup sohbeti demosu). Üretimde `rooms` okumasını `memberIds` ile
// sınırlayın ve üyeliği ayrı bir akışla yönetin.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoUrl', 'createdAt', 'lastSeenAt'])
        && isNonEmptyString(request.resource.data.displayName, 80);

      allow update: if isOwner(userId)
        // Yalnızca profil alanları güncellenebilir; uid/email gibi alanların
        // eklenmesi veya rollerin değiştirilmesi engellenir.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoUrl', 'lastSeenAt'])
        && isNonEmptyString(request.resource.data.displayName, 80);

      allow delete: if false;
    }

    // ---------------------------------------------------------------- rooms
    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.keys().hasOnly(
             ['name', 'createdBy', 'memberIds', 'createdAt',
              'lastMessage', 'lastMessageAt'])
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.name.size() >= 2;

      // Son mesaj alanları ve üye listesi güncellenebilir.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'memberIds'])
        && (!('lastMessage' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isNonEmptyString(request.resource.data.lastMessage, 2000));

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // ------------------------------------------------------------- mesajlar
      match /messages/{messageId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['senderId', 'senderName', 'text', 'createdAt'])
          && isNonEmptyString(request.resource.data.text, 2000)
          && isNonEmptyString(request.resource.data.senderName, 80);

        // Mesajlar değiştirilemez/silinemez (denetim izi).
        allow update, delete: if false;
      }
    }

    // Varsayılan: her şeyi kapat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
