rules_version = '2';

// Rebelz Media / Sohbet — Firestore güvenlik kuralları
//
// Model:
//   users/{uid}                          kullanıcı profili (sahibi yazar)
//   users/{uid}/consents/{id}            koşul onay kayıtları (kanıt)
//   users/{uid}/blocked/{blockedUid}     engellenen kullanıcılar
//   usernames/{usernameLower}            kullanıcı adı tekilliği (kilit)
//   rooms/{roomId}                       sohbet (type: dm | group)
//   rooms/{roomId}/messages/{msgId}      mesajlar
//
// Kullanıcı adı araması (`displayNameLower`/`usernameLower` aralık sorgusu)
// için Firestore'da tek alan indeksleri (otomatik) yeterlidir.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    function isUsername(value) {
      return value is string
        && value.matches('^[a-z0-9_]{3,20}$');
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'displayName', 'displayNameLower', 'email', 'emailVerified',
             'photoUrl', 'createdAt', 'lastSeenAt',
             'username', 'usernameLower', 'bio', 'avatarEmoji', 'avatarColor',
             'termsVersion', 'termsAcceptedAt',
           ])
        && isNonEmptyString(request.resource.data.displayName, 80);

      // Sahibi profil alanlarını günceller; e-posta/uid gibi alanlar sabit.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'displayName', 'displayNameLower', 'photoUrl', 'lastSeenAt',
               'username', 'usernameLower', 'bio', 'avatarEmoji',
               'avatarColor', 'termsVersion', 'termsAcceptedAt',
               'emailVerified',
             ])
        && isNonEmptyString(request.resource.data.displayName, 80)
        && (!('usernameLower' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isUsername(request.resource.data.usernameLower));

      allow delete: if false;

      // ------------------------------------------------------- koşul onayı
      // Kayıtlar oluşturulabilir, sonradan değiştirilemez (kanıt niteliği).
      match /consents/{consentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.accepted == true
          && isNonEmptyString(request.resource.data.version, 32)
          && request.resource.data.keys().hasOnly([
               'uid', 'email', 'version', 'accepted', 'platform', 'acceptedAt',
             ]);
        allow update, delete: if false;
      }

      // --------------------------------------------------------- engelleme
      // Herkes okuyabilir: gönderen, "karşı taraf beni engelledi mi?"
      // kontrolünü ancak böyle yapabilir (mesaj kuralı da bunu kullanır).
      match /blocked/{blockedUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId)
          && request.resource.data.blockedUid == blockedUid;
        allow delete: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------ usernames
    // Kullanıcı adı talebi: sahibi oluşturur/siler, herkes okuyabilir.
    match /usernames/{usernameLower} {
      // Yalnızca tekil okuma (kullanıcı adı müsait mi?) — liste kapalı.
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(request.resource.data.uid)
        && request.resource.data.uid == request.auth.uid
        && usernameLower == request.resource.data.usernameLower;
      allow delete: if isOwner(resource.data.uid);
    }

    // ---------------------------------------------------------------- rooms
    match /rooms/{roomId} {
      function room() {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in room().memberIds;
      }

      // Karşı taraf beni engellediyse mesaj gönderemem. Doğrudan sohbetler
      // iki üyelidir; iki üyenin `blocked` listesi kontrol edilir.
      function peerBlockedMe() {
        let members = room().memberIds;
        return members.size() == 2
          && (exists(/databases/$(database)/documents/users/$(members[0])
                     /blocked/$(request.auth.uid))
              || exists(/databases/$(database)/documents/users/$(members[1])
                     /blocked/$(request.auth.uid)));
      }

      // Yalnızca üyeler okur. `list` kuralı her doküman için ayrı
      // değerlendirildiği için başkasının sohbeti görülemez.
      allow get: if isMember();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Yeni sohbet: kendisi üye olmalı; doğrudan sohbette iki üye olur.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 2
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'name', 'createdBy', 'memberIds', 'createdAt', 'lastMessage',
             'lastMessageAt', 'type', 'photoUrl', 'hiddenFor', 'memberNames',
             'memberPhotos',
           ])
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.name.size() >= 1
        && (!('type' in request.resource.data)
            || request.resource.data.type in ['dm', 'group']);

      // Son mesaj, üye listesi, gizleme ve ad/fotoğraf tazelenebilir.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastMessage', 'lastMessageAt', 'memberIds', 'hiddenFor',
               'name', 'photoUrl', 'memberNames', 'memberPhotos', 'type',
             ])
        && (!('lastMessage' in request.resource.data.diff(resource.data)
                .affectedKeys())
            || isNonEmptyString(request.resource.data.lastMessage, 2000));

      // Silme: grubu yalnızca oluşturan; doğrudan sohbeti iki taraf da.
      allow delete: if signedIn()
        && ((resource.data.type == 'dm'
              && request.auth.uid in resource.data.memberIds)
            || (resource.data.createdBy == request.auth.uid
              && request.auth.uid in resource.data.memberIds));

      // ------------------------------------------------------------- mesajlar
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in room().memberIds;

        allow create: if signedIn()
          && request.auth.uid in room().memberIds
          && !peerBlockedMe()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
               'senderId', 'senderName', 'senderPhotoUrl', 'text', 'type',
               'createdAt',
             ])
          && isNonEmptyString(request.resource.data.text, 2000)
          && isNonEmptyString(request.resource.data.senderName, 80);

        // Mesaj içeriği değiştirilemez; silme yalnızca sohbeti silme
        // akışında (üyeler) yapılabilir.
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid in room().memberIds;
      }
    }

    // Varsayılan: her şeyi kapat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
